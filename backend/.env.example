# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Parc Informatique MFA

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=parc_informatique

# JWT (Sprint 2)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt (Sprint 2)
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
